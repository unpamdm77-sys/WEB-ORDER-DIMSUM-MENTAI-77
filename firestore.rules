rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwnerEmail() {
      return isVerifiedUser() && request.auth.token.email == 'unpam.dm77@gmail.com';
    }

    function isAdmin() {
      return isVerifiedUser() && (
        request.auth.token.email == 'unpam.dm77@gmail.com'
        || exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidMenuItem(data) {
      return data.keys().hasAll([
        'name', 'category', 'description', 'imageUrl',
        'variants', 'popular', 'available', 'sortOrder',
        'updatedAt', 'updatedBy'
      ])
      && data.keys().hasOnly([
        'name', 'category', 'description', 'imageUrl',
        'variants', 'popular', 'available', 'sortOrder',
        'updatedAt', 'updatedBy'
      ])
      && data.name is string && data.name.size() >= 2 && data.name.size() <= 100
      && data.category in ['Mentai Series', 'Goreng & Crispy', 'Special & Kuah', 'Paket & Cake', 'Add-On']
      && data.description is string && data.description.size() <= 300
      && data.imageUrl is string && data.imageUrl.size() >= 1 && data.imageUrl.size() <= 500
      && data.variants is list && data.variants.size() >= 1 && data.variants.size() <= 10
      && data.variants[0] is map
      && data.variants[0].keys().hasAll(['label', 'price'])
      && data.variants[0].keys().hasOnly(['label', 'price'])
      && data.variants[0].label is string && data.variants[0].label.size() >= 1 && data.variants[0].label.size() <= 40
      && data.variants[0].price is number && data.variants[0].price >= 0 && data.variants[0].price <= 10000000
      && data.popular is bool
      && data.available is bool
      && data.sortOrder is number && data.sortOrder >= 0 && data.sortOrder <= 1000
      && data.updatedAt is timestamp && data.updatedAt == request.time
      && data.updatedBy is string && data.updatedBy.size() >= 1 && data.updatedBy.size() <= 128
      && data.updatedBy == request.auth.uid;
    }

    function isValidStoreSettings(data) {
      return data.keys().hasAll([
        'storeName', 'tagline', 'whatsappNumber', 'instagramHandle',
        'instagramUrl', 'tiktokHandle', 'tiktokUrl', 'mapsUrl',
        'addressNote', 'openHours', 'announcement',
        'gofoodUrl', 'shopeefoodUrl', 'grabfoodUrl',
        'updatedAt', 'updatedBy'
      ])
      && data.keys().hasOnly([
        'storeName', 'tagline', 'whatsappNumber', 'instagramHandle',
        'instagramUrl', 'tiktokHandle', 'tiktokUrl', 'mapsUrl',
        'addressNote', 'openHours', 'announcement',
        'gofoodUrl', 'shopeefoodUrl', 'grabfoodUrl',
        'updatedAt', 'updatedBy'
      ])
      && data.storeName is string && data.storeName.size() >= 2 && data.storeName.size() <= 100
      && data.tagline is string && data.tagline.size() >= 1 && data.tagline.size() <= 140
      && data.whatsappNumber is string && data.whatsappNumber.size() >= 8 && data.whatsappNumber.size() <= 20 && data.whatsappNumber.matches('^[0-9+]+$')
      && data.instagramHandle is string && data.instagramHandle.size() >= 1 && data.instagramHandle.size() <= 80
      && data.instagramUrl is string && data.instagramUrl.size() >= 1 && data.instagramUrl.size() <= 300
      && data.tiktokHandle is string && data.tiktokHandle.size() >= 1 && data.tiktokHandle.size() <= 80
      && data.tiktokUrl is string && data.tiktokUrl.size() >= 1 && data.tiktokUrl.size() <= 300
      && data.mapsUrl is string && data.mapsUrl.size() >= 1 && data.mapsUrl.size() <= 300
      && data.addressNote is string && data.addressNote.size() >= 2 && data.addressNote.size() <= 250
      && data.openHours is string && data.openHours.size() >= 2 && data.openHours.size() <= 100
      && data.announcement is string && data.announcement.size() <= 200
      && data.gofoodUrl is string && data.gofoodUrl.size() <= 300
      && data.shopeefoodUrl is string && data.shopeefoodUrl.size() <= 300
      && data.grabfoodUrl is string && data.grabfoodUrl.size() <= 300
      && data.updatedAt is timestamp && data.updatedAt == request.time
      && data.updatedBy is string && data.updatedBy.size() >= 1 && data.updatedBy.size() <= 128
      && data.updatedBy == request.auth.uid;
    }

    function isValidAdminUser(data, adminUid) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'role', 'createdAt', 'addedBy'])
      && data.keys().hasOnly(['uid', 'email', 'displayName', 'role', 'createdAt', 'addedBy'])
      && data.uid is string && data.uid == adminUid && isValidId(data.uid)
      && data.email is string && data.email.size() >= 3 && data.email.size() <= 150
      && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100
      && data.role in ['owner', 'staff']
      && data.createdAt is timestamp
      && data.addedBy is string && data.addedBy.size() >= 1 && data.addedBy.size() <= 128
      && data.addedBy == request.auth.uid;
    }

    // Public catalog menu items (no PII)
    match /menu_items/{itemId} {
      allow get: if isValidId(itemId);
      allow list: if resource.data.name is string;

      allow create: if isAdmin()
        && isValidId(itemId)
        && isValidMenuItem(incoming());

      allow update: if isAdmin()
        && isValidId(itemId)
        && isValidMenuItem(incoming())
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'name', 'category', 'description', 'imageUrl',
          'variants', 'popular', 'available', 'sortOrder',
          'updatedAt', 'updatedBy'
        ]);

      allow delete: if isAdmin() && isValidId(itemId);
    }

    // Public storefront contact & location settings (no PII)
    match /store_settings/{settingId} {
      allow get: if isValidId(settingId);
      allow list: if false;

      allow create: if isAdmin()
        && isValidId(settingId)
        && isValidStoreSettings(incoming());

      allow update: if isAdmin()
        && isValidId(settingId)
        && isValidStoreSettings(incoming())
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'storeName', 'tagline', 'whatsappNumber', 'instagramHandle',
          'instagramUrl', 'tiktokHandle', 'tiktokUrl', 'mapsUrl',
          'addressNote', 'openHours', 'announcement',
          'gofoodUrl', 'shopeefoodUrl', 'grabfoodUrl',
          'updatedAt', 'updatedBy'
        ]);

      allow delete: if false;
    }

    // Staff authorization registry (contains staff emails -> restricted to self/owner/admin)
    match /admins/{adminUid} {
      allow get: if isVerifiedUser() && isValidId(adminUid) && (request.auth.uid == adminUid || isAdmin());
      allow list: if isAdmin() && resource.data.uid is string;

      allow create: if isOwnerEmail()
        && isValidId(adminUid)
        && isValidAdminUser(incoming(), adminUid)
        && incoming().createdAt == request.time;

      allow update: if isOwnerEmail()
        && isValidId(adminUid)
        && isValidAdminUser(incoming(), adminUid)
        && incoming().createdAt == existing().createdAt
        && incoming().uid == existing().uid
        && incoming().diff(existing()).affectedKeys().hasOnly(['email', 'displayName', 'role', 'addedBy']);

      allow delete: if isOwnerEmail() && isValidId(adminUid);
    }
  }
}

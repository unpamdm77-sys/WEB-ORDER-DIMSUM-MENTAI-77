# GEMINI_API_KEY: Required if Gemini AI features are added (optional).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Public URL of the deployed website (e.g. https://dimsum-mentai-77.vercel.app).
APP_URL="MY_APP_URL"

# VITE_GOOGLE_MAPS_API_KEY: Google Maps Platform JavaScript & Places API key.
# Set this in Vercel -> Project Settings -> Environment Variables.
VITE_GOOGLE_MAPS_API_KEY="MY_GOOGLE_MAPS_API_KEY"

# STAFF_SESSION_SECRET: Secret key for signing Staff & Owner session tokens on Vercel.
# Recommended: set a random 32+ character string in Vercel Environment Variables.
STAFF_SESSION_SECRET="CHANGE_ME_TO_A_RANDOM_SECRET_KEY"

# FIREBASE_API_KEY: Optional fallback override for Owner Google ID token verification.
# By default read automatically from firebase-applet-config.json.
FIREBASE_API_KEY=""
